GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
HOST=0.0.0.0
PORT=8000

# Login (form kustom, bukan popup Basic Auth browser -- lihat #loginOverlay
# di index.html) utk seluruh /api/*, diverifikasi terhadap tabel users
# (scripts/schema_users.sql) -- role admin/user, lihat auth.py &
# scripts/manage_users.py. Nilai di sini CUMA dipakai SEKALI sbg seed akun
# admin pertama saat tabel users masih kosong (app.py startup) -- setelah
# itu kelola akun lewat scripts/manage_users.py, bukan .env lagi. Kosongkan
# keduanya (dan jangan buat user manapun) untuk menonaktifkan login
# sepenuhnya (dev lokal tanpa login).
APP_USERNAME=
APP_PASSWORD=

# Kunci penanda-tangan cookie sesi login (auth.py create_session_token) --
# WAJIB diset di staging/produksi supaya sesi login tidak langsung tidak
# valid tiap kali server restart (tanpa ini, jatuh ke nilai acak per-proses).
# String acak panjang bebas, mis. `python -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET=

# Groq API (chat assistant di sidebar) — dapatkan key gratis di console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# BPS Web API (webapi.bps.go.id) -- daftar gratis, dipakai preview link PDF
# "Dalam Angka" resmi (GET /api/usulan-inpres/{id}/dalam-angka,
# scripts/sync_dalam_angka_bps_api.py). Tanpa key ini, endpoint tetap
# jalan tapi pakai link tersimpan (bisa kedaluwarsa) alih-alih regenerasi
# token segar tiap request.
BPS_API_KEY=

# PostgreSQL/PostGIS -- database utama app.py (db_cursor() di db.py) sekaligus
# layer peta Maps/ (map_layers/map_layer_meta, lihat
# scripts/import_maps_to_postgis.py). Satu database, satu set kredensial.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASS=
PG_DB=route_gis
